{
  "name": "veizik-edge-llm-linux-aarch64",
  "runtime": "veizik edge (aarch64 CPU, pure-.lim dep0)",
  "launcher": "PIPELINE.sh --model <tag> --prompt-file F --out DIR [--max-tokens N] [--mode quality|balanced|fast|ultrafast|low-memory]",
  "weights": "canonical VZQ1 master pack models/<tag>/<tag>.vzqup (+ optional pinned caches <tag>.vzqup.cache.<code>)",
  "env": [
    "VZ_VZQ",
    "VZ_MODE",
    "VZ_POWER",
    "VZ_ACCEL",
    "VZ_HYBRID"
  ],
  "outputs": [
    "completion.txt",
    "result.json",
    "engine.log"
  ]
}